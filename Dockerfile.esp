# syntax=docker/dockerfile:1
FROM espressif/idf:release-v5.4

ARG NODE_VERSION=22.14.0

USER root

# Install QEMU for Xtensa (ESP32 / ESP32-S3 / M5Stack Atom, AtomS3) & RISC-V
RUN python3 "${IDF_PATH}/tools/idf_tools.py" install qemu-xtensa qemu-riscv32

# Install ripgrep + Node.js + pi-coding-agent, then remove apt/dpkg/curl/wget
RUN apt-get update && apt-get install -y --no-install-recommends \
    ripgrep \
    xz-utils \
    curl \
    ca-certificates \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    | tar -xJ -C /usr/local \
    && mv "/usr/local/node-v${NODE_VERSION}-linux-x64" /usr/local/node \
    && PATH="/usr/local/node/bin:${PATH}" npm install -g @earendil-works/pi-coding-agent \
    && PATH="/usr/local/node/bin:${PATH}" npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/bin/curl /usr/bin/wget \
    && rm -rf /var/cache/apt /var/lib/dpkg /usr/bin/apt* /usr/bin/dpkg*

# Non-root user & writable cache directories
RUN groupadd -g 1000 agent \
    && useradd -m -u 1000 -g 1000 -s /bin/bash agent \
    && mkdir -p /workspace /refs /home/agent/.pi/agent/sessions /home/agent/.npm \
    && chown -R agent:agent /workspace /home/agent

# Entrypoint that exports ESP-IDF + QEMU into PATH before launching pi
RUN printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -e' \
    'if [ -f "${IDF_PATH}/export.sh" ]; then' \
    '  . "${IDF_PATH}/export.sh" >/dev/null 2>&1' \
    'fi' \
    'exec pi "$@"' \
    > /usr/local/bin/pi-esp-entrypoint.sh \
    && chmod +x /usr/local/bin/pi-esp-entrypoint.sh

ENV HOME=/home/agent \
    NPM_CONFIG_CACHE=/home/agent/.npm \
    PATH="/usr/local/node/bin:/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

USER agent
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/pi-esp-entrypoint.sh"]
