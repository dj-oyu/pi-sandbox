# syntax=docker/dockerfile:1
FROM pi-sandbox:latest AS base-tools

FROM debian:bookworm-slim

COPY --from=base-tools /usr/local/node /usr/local/node
COPY --from=base-tools /usr/local/go /usr/local/go
COPY --from=base-tools /usr/local/rustup /usr/local/rustup
COPY --from=base-tools /usr/local/cargo /usr/local/cargo
COPY --from=base-tools /usr/local/bin/uv /usr/local/bin/uv
COPY --from=base-tools /usr/local/bin/uvx /usr/local/bin/uvx

ENV PATH="/usr/local/node/bin:${PATH}" \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    ripgrep \
    gcc \
    libc6-dev \
    pkg-config \
    make \
    && npm install -g playwright \
    && npx playwright install --with-deps chromium \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/bin/curl /usr/bin/wget \
    && rm -rf /var/cache/apt /var/lib/dpkg /usr/bin/apt* /usr/bin/dpkg*

RUN groupadd -g 1000 agent \
    && useradd -m -u 1000 -g 1000 -s /bin/bash agent \
    && mkdir -p /workspace /refs /home/agent/.pi/agent/sessions /home/agent/.cargo /home/agent/go /home/agent/.cache/uv /home/agent/.npm \
    && chown -R agent:agent /workspace /home/agent \
    && chmod -R a+rX /opt/pw-browsers

ENV HOME=/home/agent \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/home/agent/.cargo \
    GOPATH=/home/agent/go \
    UV_CACHE_DIR=/home/agent/.cache/uv \
    NPM_CONFIG_CACHE=/home/agent/.npm \
    NODE_PATH=/usr/local/node/lib/node_modules \
    PATH="/home/agent/.cargo/bin:/home/agent/go/bin:/usr/local/cargo/bin:/usr/local/go/bin:/usr/local/node/bin:/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

USER agent
WORKDIR /workspace

ENTRYPOINT ["pi"]
