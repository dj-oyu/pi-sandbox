# syntax=docker/dockerfile:1
FROM node:22-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ cmake autoconf automake libtool xz-utils curl ca-certificates \
    && npm install -g aws-lambda-ric \
    && curl -fsSL https://github.com/aws/aws-lambda-runtime-interface-emulator/releases/latest/download/aws-lambda-rie \
       -o /usr/local/bin/aws-lambda-rie \
    && chmod +x /usr/local/bin/aws-lambda-rie \
    && rm -rf /var/lib/apt/lists/*

FROM node:22-slim

RUN mkdir -p /var/task && chown -R node:node /var/task

COPY --from=builder /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=builder /usr/local/bin/aws-lambda-ric /usr/local/bin/aws-lambda-ric
COPY --from=builder /usr/local/bin/aws-lambda-rie /usr/local/bin/aws-lambda-rie

ENV LAMBDA_TASK_ROOT=/var/task \
    NODE_PATH=/var/task/node_modules:/usr/local/lib/node_modules

USER node
WORKDIR /var/task

ENTRYPOINT ["/usr/local/bin/aws-lambda-rie", "node", "/usr/local/lib/node_modules/aws-lambda-ric/index.mjs"]
CMD ["index.handler"]
